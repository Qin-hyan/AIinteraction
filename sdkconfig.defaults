# ESP32-S3-EYE v2.2 项目默认配置
# 真实 Wi-Fi SSID 和密码请通过 idf.py menuconfig 配置，或直接编辑本地 sdkconfig
# 本文件仅作为公开仓库的默认模板，不保存真实凭据

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# 启用 PSRAM (8MB Octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Wi-Fi — 请在此处或 menuconfig 中填入真实凭据
CONFIG_ESP_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_HTTPD_MAX_URI_LEN=512

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Week 05 语音控制（ESP32 PLAY 按键 → PC 录音控制接口，见 main/voice_button.c）
# 默认空 = 语音控制关闭（不创建任务/队列，启动时打印提示，PLAY 按键保持 Week 03 行为）。
# 实际开发环境通过本地已 gitignore 的 sdkconfig（或 idf.py menuconfig → Week 05 Voice Control）
# 填写 PC 语音服务基地址，形如 http://192.168.x.x:8080（不含路径）；
# 本地 sdkconfig 中的同名配置优先于本模板（构建实际以本地 sdkconfig 为准），
# 因此本共享模板不写入当前开发网/实验网的 DHCP 私有 IP。
CONFIG_VOICE_PC_URL=""
# 单次请求超时（ms），仅限制后台任务的阻塞时长，不影响按键扫描与主循环。
CONFIG_VOICE_HTTP_TIMEOUT_MS=5000

# Week 08 视觉反馈（Dashboard 内嵌面板 → 本机视觉 API，见 service/vision_feedback_server.py）
# 默认 127.0.0.1:8090 = 本机回环地址，不泄露设备/电脑局域网 IP；
# 置空则隐藏「视觉反馈」面板功能。
CONFIG_VISION_API_URL="http://127.0.0.1:8090"